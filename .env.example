# Production: Neon connection string. When set (and DB_DRIVER unset), the neon driver is used.
DATABASE_URL=
# Local dev / tests: pglite (offline). "memory" uses an in-memory DB.
DB_DRIVER=pglite
PGLITE_DIR=.pglite/dev
# Test mode enables /api/test/* routes and the x-test-now time override. NEVER set in production.
TEST_MODE=0
# "fixture" reads fixtures/espn/*.json instead of calling ESPN.
ESPN_MODE=real
# Staging-only accent color tuner in the account menu. Ignored on Vercel Production (VERCEL_ENV=production).
THEME_TUNER=0
# First admin, created by `npm run db:seed`. Defaults (admin / 1234 / Admin) apply to local pglite only. With the neon driver or NODE_ENV=production
# all three are required and trivial PINs (1234, 0000, 1111, ...) are refused. PIN must be exactly 4 digits.
ADMIN_USERNAME=
ADMIN_PIN=
ADMIN_FIRST_NAME=
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron/sync. Required in production.
CRON_SECRET=
